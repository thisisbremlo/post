import("//tools/grit/grit_rule.gni")

# resources/post_resources.grd is generated by `npm run fork:assets`, together
# with the desk bundle it lists.
grit("post_resources") {
  source = "resources/post_resources.grd"
  output_dir = "$root_gen_dir/chrome"
  outputs = [
    "grit/post_resources.h",
    "grit/post_resources_map.cc",
    "grit/post_resources_map.h",
  ]
}

source_set("post") {
  sources = [
    "post_handler.cc",
    "post_handler.h",
    "post_ui.cc",
    "post_ui.h",
  ]

  deps = [
    ":post_resources",
    "//base",
    "//chrome/browser/profiles:profiles",
    "//chrome/browser/ui",
    "//components/prefs",
    "//content/public/browser",
    "//ui/base",
    "//ui/webui",
    "//url",
  ]
}
