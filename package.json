{
  "name": "scaffold",
  "productName": "Scaffold",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A browser for building on other people's work",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "desktop": "npm run build && electron .",
    "desktop:dev": "VITE_DEV_SERVER_URL=http://localhost:3000 electron ."
  },
  "dependencies": {
    "@fontsource-variable/instrument-sans": "^5.1.1",
    "lucide-react": "^1.70.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.0",
    "typescript": "^5.6.3",
    "vite": "^6.3.5"
  }
}
