{
  "name": "post",
  "productName": "Post",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Post — a browser for building on other people's work",
  "author": "thisisbremlo",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "desktop": "npm run build && electron .",
    "desktop:dev": "VITE_DEV_SERVER_URL=http://localhost:3000 electron .",
    "package": "node scripts/bake-checkout.mjs && npm run build && electron-builder",
    "package:mac": "node scripts/bake-checkout.mjs && npm run build && electron-builder --mac",
    "package:dir": "node scripts/bake-checkout.mjs && npm run build && electron-builder --dir",
    "stamp": "node scripts/stamp-update.mjs"
  },
  "build": {
    "appId": "com.thisisbremlo.post",
    "productName": "Post",
    "copyright": "Copyright © 2026 thisisbremlo",
    "asar": true,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "!node_modules/@ghostery/trackerdb/dist/trackerdb.db",
      "!node_modules/@ghostery/trackerdb/dist/trackerdb.json",
      "!node_modules/@ghostery/trackerdb/dist/trackerdb.txt",
      "!node_modules/@ghostery/trackerdb/dist/mjs/**/*"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.png",
      "target": [{ "target": "dmg", "arch": ["arm64", "x64"] }]
    },
    "win": {
      "icon": "build/icon.png",
      "target": ["nsis"]
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Network",
      "target": ["AppImage"]
    }
  },
  "dependencies": {
    "@ghostery/adblocker-electron": "^2.20.3",
    "@ghostery/trackerdb": "^1.0.969"
  },
  "devDependencies": {
    "@fontsource-variable/instrument-sans": "^5.1.1",
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "lucide-react": "^1.70.0",
    "motion": "^14.10.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sharp": "^0.35.5",
    "typescript": "^5.6.3",
    "vite": "^6.3.5"
  }
}
